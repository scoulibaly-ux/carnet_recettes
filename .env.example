# Neon PostgreSQL. En développement, sans cette variable, les dossiers
# sont enregistrés dans data/recouvrement.json (fichier local, non versionné).
# En production, DATABASE_URL est obligatoire.
DATABASE_URL=

# Session de l'unique administrateur. AUTH_SECRET signe le cookie.
AUTH_SECRET=
ADMIN_PASSWORD=

# URL https publique de l'application, sans slash final.
# Twilio s'en sert pour demander le TwiML et envoyer les statuts.
# Exemple : https://votre-app.vercel.app
APP_BASE_URL=

# Twilio place l'appel sortant.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ElevenLabs Conversational AI conduit la voix.
# L'agent peut lire les variables nom_debiteur, montant, reference, telephone.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Secret du déclencheur planifié.
# Authorization: Bearer <CRON_SECRET> sur GET ou POST /api/appels/declencher
CRON_SECRET=
